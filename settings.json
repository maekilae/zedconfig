    "cli_default_open_behavior": "existing_window",
    "agent_servers": {
        "claude-acp": {
            "default_config_options": {
                "model": "opus",
                "effort": "high",
                "mode": "auto"
            },
            "type": "registry",
        },
    },
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
    },
    "git_panel": {
        "dock": "left",
    },
    "language_models": {
        "open_router": {
            "api_url": "https://openrouter.ai/api/v1",
            "available_models": [
                {
                    "name": "google/gemini-2.0-flash-thinking-exp",
                    "display_name": "Gemini 2.0 Flash (Thinking)",
                    "max_tokens": 200000,
                    "max_output_tokens": 8192,
                    "supports_tools": true,
                    "supports_images": true,
                    "mode": {
                        "type": "thinking",
                        "budget_tokens": 8000,
                    },
                },
                {
                    "name": "moonshotai/kimi-k3",
                    "display_name": "kimi-k3",
                    "max_tokens": 200000,
                    "max_output_tokens": 8192,
                    "supports_tools": true,
                    "supports_images": false,
                    "mode": {
                        "type": "thinking",
                        "budget_tokens": 8000,
                    },
                },
            ],
        },
    },
    "agent": {
        "dock": "right",
        "default_model": {
            "provider": "openrouter",
            "model": "moonshotai/kimi-k3",
            "enable_thinking": true,
        },
        "favorite_models": [],
        "model_parameters": [],
        "commit_message_model": {
            "provider": "openrouter",
            "model": "google/gemini-2.0-flash-thinking-exp",
            "enable_thinking": false,
        },
    },
    "edit_predictions": {
        "disabled_globs": [
            "**/.git",
            "**/.svn",
            "**/.hg",
            "**/CVS",
            "**/.DS_Store",
            "**/Thumbs.db",
            "**/.classpath",
            "**/.settings",
            "**/.vscode",
            "**/.idea",
            "**/node_modules",
            "**/.serverless",
            "**/build",
            "**/dist",
            "**/coverage",
            "**/.evnv",
            "**/__pycache__",
            "**/.ropeproject",
            "**/.pytest_cache",
            "**/.ruff_cache",
        ],
        "mode": "eager",
        "copilot": {
            "proxy": null,
            "proxy_no_verify": null,
        },
    },
    "git": {
        "git_gutter": "tracked_files",
        "inline_blame": {
            "enabled": true,
        },
        "branch_picker": {
            "show_author_name": true,
        },
        "hunk_style": "staged_hollow",
    },
    "diff_view_style": "unified",
    "load_direnv": "shell_hook",
    "vim_mode": true,
    "relative_line_numbers": "enabled",
    "scrollbar": {
        "show": "never",
    },
    "tab_size": 4,
    "tab_bar": {
        "show": true,
        "show_nav_history_buttons": false,
    },
    "tabs": {
        "file_icons": true,
        "git_status": true,
    },
    "indent_guides": {
        "enabled": true,
        "coloring": "indent_aware",
    },
    "file_types": {
        "Dockerfile": ["Dockerfile", "Dockerfile.*"],
        "JSON": ["json", "jsonc", "jsonl", "*.code-snippets"],
    },
    "file_scan_exclusions": [
        "**/.git",
        "**/.svn",
        "**/.hg",
        "**/CVS",
        "**/.DS_Store",
        "**/Thumbs.db",
        "**/.classpath",
        "**/.settings",
        "**/.vscode",
        "**/.idea",
        "**/node_modules",
        "**/.serverless",
        "**/build",
        "**/dist",
        "**/coverage",
        "**/.venv",
        "**/__pycache__",
        "**/.ropeproject",
        "**/.pytest_cache",
        "**/.ruff_cache",
    ],
    "project_panel": {
        "button": false,
        "default_width": 300,
        "dock": "left",
        "file_icons": true,
        "folder_icons": true,
        "git_status": true,
        "scrollbar": {
            "show": "never",
        },
    },
    "lsp": {
        "qmljs": {
            "binary": {
                "arguments": ["-E", "additional-args"],
            },
        },
        "tinymist": {
            "settings": {
                "exportPdf": "onSave",
                "outputPath": "$root/$name",
            },
        },
    },
    "languages": {
        "C": {
            "format_on_save": "on",
        },
    },
    "terminal": {
        "shell": {
            "program": "fish",
        },
        "font_family": "JetBrainsMono Nerd Font Mono",
        "font_weight": 400,
    },
    "icon_theme": "Material Icon Theme",
    "ui_font_family": "JetBrainsMono Nerd Font Mono",
    "ui_font_weight": 400,
    "ui_font_size": 16,
    "buffer_font_family": "JetBrainsMono Nerd Font Mono",
    "buffer_font_weight": 700,
    "buffer_font_size": 15,
    "agent_buffer_font_size": 13,
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "Vague",
    },

    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
}
